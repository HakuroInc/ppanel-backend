PPANEL_IMAGE=ghcr.io/as207299/ppanel-backend
# Rewritten by every deploy (full commit sha of the production branch).
PPANEL_TAG=production
# First-start database DSN, e.g. user:pass@tcp(host:3306)/ppanel?tls=true
PPANEL_DB=
# 1 = a deploy whose container is not healthy within DEPLOY_HEALTH_TIMEOUT
# fails and is rolled back to the previous tag. Keep 0 until the database is
# configured, otherwise every deploy would be rolled back.
DEPLOY_REQUIRE_HEALTHY=0
DEPLOY_HEALTH_TIMEOUT=180
